<!--Curso: Análise e Desenvolvimento de Sistemas
    Aluno: Saulo Torres de Oliveira Assis
    Professor: André Gustavo
    Projeto: SORT-X - Onde o acaso encontra a intuição-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="30dp"
    android:background="#202124"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SORT-X"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Onde o acaso encontra a intuição"
        android:textColor="#BDC1C6"
        android:textSize="16sp"
        android:layout_marginBottom="40dp"
        android:textAlignment="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Qual o número secreto de 1 a 10?"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/idEntrada"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#3B82F6"
        android:hint="?"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:textColorHint="#5F6368"
        android:textAlignment="center"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/idBotaoChute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#3B82F6"
        android:text="DESVENDAR"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/idTextoStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textColor="#4ADE80"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:text="Desenvolvido por Saulo Torres"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:alpha="0.6" />

</LinearLayout>